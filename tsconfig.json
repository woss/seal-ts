{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "module": "nodenext",
    "moduleResolution": "node16",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": ["node"],
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
